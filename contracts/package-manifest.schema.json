{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.dev/beacon/contracts/package-manifest.schema.json",
  "title": "Beacon publication package manifest",
  "description": "Deterministic metadata for a verified local Beacon artifact package.",
  "type": "object",
  "required": [
    "schema_version",
    "profile",
    "profile_version",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "theme": { "type": "string", "minLength": 1 },
    "source_repository": { "type": "string", "minLength": 1 },
    "source_revision": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^artifacts/(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
