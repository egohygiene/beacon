{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.dev/beacon/contracts/template-manifest.schema.json",
  "title": "Beacon template manifest",
  "description": "Schema documentation for active beacon-template.toml publication profile packages.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "description",
    "category",
    "license",
    "source",
    "outputs",
    "metadata",
    "initializer",
    "capabilities"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["format", "renderer"],
        "properties": {
          "format": { "type": "string", "minLength": 1 },
          "variant": { "type": "string", "minLength": 1 },
          "renderer": { "type": "string", "minLength": 1 },
          "template": { "$ref": "#/$defs/relativePath" },
          "entrypoint": { "$ref": "#/$defs/relativePath" },
          "artifact": { "$ref": "#/$defs/relativePath" }
        },
        "anyOf": [
          { "required": ["template"] },
          { "required": ["entrypoint"] },
          { "required": ["artifact"] }
        ],
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "optional": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "initializer": {
      "type": "object",
      "required": ["runtime", "script", "required", "optional"],
      "properties": {
        "runtime": { "const": "python3" },
        "script": { "$ref": "#/$defs/relativePath" },
        "required": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/initializerParameter" },
          "uniqueItems": true,
          "allOf": [
            { "contains": { "const": "destination" } },
            { "contains": { "const": "title" } },
            {
              "anyOf": [
                { "contains": { "const": "author" } },
                { "contains": { "const": "publisher" } }
              ]
            }
          ]
        },
        "optional": {
          "type": "array",
          "items": { "$ref": "#/$defs/initializerParameter" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "boolean" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:/|[A-Za-z]:|.*(?:^|/)\\.\\.(?:/|$))" }
    },
    "initializerParameter": {
      "enum": [
        "author",
        "destination",
        "edition",
        "project-id",
        "publisher",
        "theme",
        "title"
      ]
    }
  },
  "additionalProperties": false
}
