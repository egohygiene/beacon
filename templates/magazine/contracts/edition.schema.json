{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.egohygiene.io/beacon/magazine/edition/v1.json",
  "title": "Beacon Magazine Edition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "edition_number",
    "date",
    "version",
    "language",
    "description",
    "creators",
    "rights",
    "pages"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "edition_number": { "type": "string", "minLength": 1 },
    "edition_name": { "type": "string" },
    "date": { "type": "string", "format": "date" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "language": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]+)*$" },
    "description": { "type": "string", "minLength": 1 },
    "creators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "roles"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["copyright", "license"],
      "properties": {
        "copyright": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "pattern": "^pages/[A-Za-z0-9._/-]+/page\\.json$"
      }
    }
  }
}
