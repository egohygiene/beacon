\newcommand{\BeaconCropMarks}{%
  \ifBeaconPrint
    \begin{tikzpicture}[remember picture,overlay,line width=0.35pt,color=black]
      \draw ([xshift=0pt,yshift=\BeaconBleed]current page.south west) -- ([xshift=\dimexpr\BeaconBleed-2pt\relax,yshift=\BeaconBleed]current page.south west);
      \draw ([xshift=\BeaconBleed,yshift=0pt]current page.south west) -- ([xshift=\BeaconBleed,yshift=\dimexpr\BeaconBleed-2pt\relax]current page.south west);
      \draw ([xshift=-\dimexpr\BeaconBleed-2pt\relax,yshift=\BeaconBleed]current page.south east) -- ([xshift=0pt,yshift=\BeaconBleed]current page.south east);
      \draw ([xshift=-\BeaconBleed,yshift=0pt]current page.south east) -- ([xshift=-\BeaconBleed,yshift=\dimexpr\BeaconBleed-2pt\relax]current page.south east);
      \draw ([xshift=0pt,yshift=-\BeaconBleed]current page.north west) -- ([xshift=\dimexpr\BeaconBleed-2pt\relax,yshift=-\BeaconBleed]current page.north west);
      \draw ([xshift=\BeaconBleed,yshift=0pt]current page.north west) -- ([xshift=\BeaconBleed,yshift=-\dimexpr\BeaconBleed-2pt\relax]current page.north west);
      \draw ([xshift=-\dimexpr\BeaconBleed-2pt\relax,yshift=-\BeaconBleed]current page.north east) -- ([xshift=0pt,yshift=-\BeaconBleed]current page.north east);
      \draw ([xshift=-\BeaconBleed,yshift=0pt]current page.north east) -- ([xshift=-\BeaconBleed,yshift=-\dimexpr\BeaconBleed-2pt\relax]current page.north east);
    \end{tikzpicture}%
  \fi
}
\AddToShipoutPictureFG{\BeaconCropMarks}

\newcommand{\BeaconFooter}[1]{%
  \vfill
  \noindent\textcolor{BeaconMuted}{\rule{\linewidth}{0.35pt}}\\[-0.1em]
  {\fontsize{7.5}{9}\selectfont\color{BeaconMuted}\MakeUppercase{\BeaconMagazineTitle\ / \BeaconEditionLabel}\hfill #1}
}

\newcommand{\BeaconDarkFooter}[1]{%
  \vfill
  \noindent\textcolor{white!35}{\rule{\linewidth}{0.35pt}}\\[-0.1em]
  {\fontsize{7.5}{9}\selectfont\color{white!72}\MakeUppercase{\BeaconPublisher\ / \BeaconEditionLabel}\hfill #1}
}

\newcommand{\BeaconKicker}[1]{%
  {\fontsize{8}{10}\selectfont\bfseries\color{BeaconAccent}\MakeUppercase{#1}\par}
}

\newcommand{\BeaconDarkKicker}[1]{%
  {\fontsize{8}{10}\selectfont\bfseries\color{white!78}\MakeUppercase{#1}\par}
}

\newcommand{\BeaconNetworkMotif}{%
  \begin{center}
  \begin{tikzpicture}[x=1in,y=1in]
    \foreach \radius/\opacity in {0.55/70,1.05/50,1.55/28}{
      \draw[BeaconHighlight!\opacity,line width=0.55pt] (0,0) circle (\radius);
    }
    \foreach \angle in {10,55,105,155,205,255,305}{
      \draw[white!28,line width=0.45pt] (0,0) -- (\angle:1.55);
      \fill[BeaconAccent!85] (\angle:1.55) circle (1.9pt);
    }
    \fill[BeaconPaper] (0,0) circle (6pt);
    \fill[BeaconHighlight!85] (0,0) circle (3pt);
    \node[draw=white!70,diamond,minimum size=0.95in,line width=0.7pt] at (0,0) {};
  \end{tikzpicture}
  \end{center}
}

\newcommand{\BeaconFlowMotif}{%
  \begin{tikzpicture}[node distance=0.5in,>=latex]
    \tikzset{flow/.style={draw=BeaconAccent,rounded corners=4pt,minimum width=2.05in,minimum height=0.56in,align=center,font=\small\bfseries,fill=BeaconPaper}}
    \tikzset{output/.style={draw=BeaconAccent,rounded corners=4pt,minimum width=0.88in,minimum height=0.5in,align=center,font=\fontsize{7.5}{9}\selectfont\bfseries,fill=BeaconPaper}}
    \node[flow] (source) {Edition + page sources};
    \node[flow,below=of source] (validate) {Validate + review};
    \node[flow,below=of validate] (render) {Deterministic render};
    \node[output,below=0.52in of render,xshift=-0.98in] (pdf) {Digital PDF};
    \node[output,below=0.52in of render] (print) {Print PDF};
    \node[output,below=0.52in of render,xshift=0.98in] (web) {Web edition};
    \draw[->,BeaconHighlight,line width=0.9pt] (source) -- (validate);
    \draw[->,BeaconHighlight,line width=0.9pt] (validate) -- (render);
    \draw[->,BeaconHighlight,line width=0.9pt] (render) -- (pdf);
    \draw[->,BeaconHighlight,line width=0.9pt] (render) -- (print);
    \draw[->,BeaconHighlight,line width=0.9pt] (render) -- (web);
  \end{tikzpicture}
}

\newenvironment{BeaconCoverPage}[4]{%
  \def\BeaconCurrentPageNumber{#4}
  \BeaconCanvas{BeaconPrimary}
  \color{white}
  \noindent\begin{minipage}[t][\dimexpr\textheight-\baselineskip\relax][t]{\textwidth}
  \BeaconDarkKicker{#1}
  \vspace{0.18in}
  {\rmfamily\fontsize{43}{45}\selectfont\bfseries\raggedright #2\par}
  \vspace{0.12in}
  {\Large\color{white!78}\raggedright #3\par}
  \vspace{0.32in}
  \BeaconNetworkMotif
  \vspace{0.18in}
  \small\color{white!86}\begin{multicols}{2}
}{%
  \end{multicols}
  \BeaconDarkFooter{\BeaconCurrentPageNumber}
  \end{minipage}
}

