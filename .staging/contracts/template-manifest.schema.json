{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.dev/beacon/contracts/template-manifest.schema.json",
  "title": "Beacon Template Manifest",
  "description": "Schema documentation for beacon-template.toml packages.",
  "type": "object",
  "required": ["schema_version", "id", "name", "version", "description", "outputs", "metadata", "capabilities"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string", "minLength": 1},
    "category": {"type": "string"},
    "license": {"type": "string"},
    "source": {"type": "string"},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["format", "renderer", "template"],
        "properties": {
          "format": {"type": "string"},
          "renderer": {"type": "string"},
          "template": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "required": ["required", "optional"],
      "properties": {
        "required": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "optional": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    }
  },
  "additionalProperties": true
}
